# LiteLLM 管理用 master key（自訂，需以 sk- 開頭）
LITELLM_MASTER_KEY=
# Postgres 密碼（僅本機）
POSTGRES_PASSWORD=
# Gemini API key，供 LiteLLM 呼叫上游模型
GOOGLE_API_KEY=
# Keycloak 管理員密碼（僅本機）
KEYCLOAK_ADMIN_PASSWORD=
# 以下為 keycloak/realm-governance.json 中的測試值，非真實憑證
AI_GATEWAY_CLIENT_SECRET=ai-gateway-test-secret
KYT_AGENT_CLIENT_SECRET=kyt-agent-test-secret
ALICE_PASSWORD=alice-test-pw
BOB_PASSWORD=bob-test-pw

# 主機上的整合測試使用（資料庫不存在時會自動建立）
GOV_TEST_DATABASE_URL=postgresql://litellm:<POSTGRES_PASSWORD>@127.0.0.1:55433/governance_test
